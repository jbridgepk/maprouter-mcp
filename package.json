{
  "name": "maprouter-mcp",
  "version": "0.1.0",
  "description": "MCP server for MapRouter: maps your agent can set up, and a bill that can't run away.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "maprouter-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./snippets": {
      "types": "./dist/snippets.d.ts",
      "default": "./dist/snippets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "start": "node src/stdio.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jbridgepk/maprouter-mcp"
  },
  "homepage": "https://maprouter.dev/docs/mcp",
  "mcpName": "dev.maprouter/mcp"
}
